// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=5
// Khớp botdown/engine_macd_rsi_bt.py (MACD hist cross + RSI, TP/SL %, tùy chọn EMA bull/bear).
// Khuyến nghị: khung **1D** — ít nhiễu hơn 1H; có thể áp khung khác nhưng cần chỉnh TP/SL.
strategy("MACD + RSI % TP/SL (Python backtest)", overlay=true,
     margin_long=100, margin_short=100,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.05,
     pyramiding=0, process_orders_on_close=true)

// === Tham số trùng MacdRsiParams (mặc định) ===
fastLen     = input.int(12, "MACD fast", minval=1)
slowLen     = input.int(26, "MACD slow", minval=1)
sigLen      = input.int(9, "MACD signal", minval=1)
rsiLen      = input.int(14, "RSI length", minval=2)
rsiOb       = input.float(70.0, "RSI overbought (long cần dưới ngưỡng)", step=0.5)
rsiOs       = input.float(30.0, "RSI oversold (short cần trên ngưỡng)", step=0.5)
tpPct       = input.float(10.0, "Take profit %", minval=0.1, step=0.5) / 100.0
slPct       = input.float(4.0, "Stop loss %", minval=0.1, step=0.5) / 100.0
allowShort  = input.bool(true, "Cho phép short")

gTrend      = "EMA xu hướng (bull/bear)"
useEmaTrend = input.bool(false, "Lọc theo EMA bull/bear", group=gTrend)
emaTrendFast = input.int(20, "EMA nhanh", minval=1, group=gTrend)
emaTrendSlow = input.int(50, "EMA chậm (50)", minval=2, group=gTrend)

[macdLine, signalLine, histLine] = ta.macd(close, fastLen, slowLen, sigLen)
rsi = ta.rsi(close, rsiLen)
emaF = ta.ema(close, emaTrendFast)
emaS = ta.ema(close, emaTrendSlow)
bullTrend = emaF > emaS and close > emaS
bearTrend = emaF < emaS and close < emaS

longSigRaw  = ta.crossover(histLine, 0) and rsi < rsiOb
shortSigRaw = ta.crossunder(histLine, 0) and rsi > rsiOs and allowShort
longSig  = useEmaTrend ? (longSigRaw and bullTrend) : longSigRaw
shortSig = useEmaTrend ? (shortSigRaw and bearTrend) : shortSigRaw

var float bracketSL = na
var float bracketTP = na

if longSig and strategy.position_size == 0
    bracketSL := close * (1.0 - slPct)
    bracketTP := close * (1.0 + tpPct)
    strategy.entry("Long", strategy.long)

if shortSig and strategy.position_size == 0
    bracketSL := close * (1.0 + slPct)
    bracketTP := close * (1.0 - tpPct)
    strategy.entry("Short", strategy.short)

if strategy.position_size > 0
    strategy.exit("BrL", "Long", stop=bracketSL, limit=bracketTP)

if strategy.position_size < 0
    strategy.exit("BrS", "Short", stop=bracketSL, limit=bracketTP)

if strategy.position_size == 0
    bracketSL := na
    bracketTP := na

// Gợi ý hiển thị
plotshape(longSig and strategy.position_size[1] == 0, title="Long signal", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(shortSig and strategy.position_size[1] == 0 and allowShort, title="Short signal", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

plot(useEmaTrend ? emaF : na, "EMA nhanh", color=color.new(color.orange, 0), linewidth=1)
plot(useEmaTrend ? emaS : na, "EMA 50 xu hướng", color=color.new(color.blue, 0), linewidth=2)
