//@version=5
// Volume profile cuộn trên OHLCV: phân bổ volume vào bin giá (giống hướng tiếp cận Python strategy/volume_profile.py).
// POC = bin volume lớn nhất; VAL/VAH = mở rộng từ POC đến khi đạt % value area.
// Khuyến nghị: 1D hoặc 1H; giảm lookback/bins nếu chart lag.
// Alert: Condition → script này → chọn điều kiện; Trigger: Once Per Bar Close.
indicator("Rolling Volume Profile — POC/VAL/VAH", shorttitle="Roll VP", overlay=true)

// ─── Inputs ─────────────────────────────────────────────────────────────
gVP = "Volume profile"
i_lookback = input.int(48, "Lookback (nến)", minval=10, maxval=500, group=gVP)
i_bins     = input.int(24, "Số bin giá", minval=8, maxval=64, group=gVP)
i_vaPct    = input.float(70.0, "Value area %", minval=50.0, maxval=95.0, step=1.0, group=gVP) / 100.0

gPlot = "Hiển thị"
i_showPOC = input.bool(true, "Vẽ POC", group=gPlot)
i_showVA  = input.bool(true, "Vẽ VAL & VAH", group=gPlot)
i_showBg  = input.bool(true, "Tô trong value area", group=gPlot)
i_colPOC  = input.color(color.new(#FF9800, 0), "Màu POC", group=gPlot)
i_colVA   = input.color(color.new(#2196F3, 60), "Màu VA", group=gPlot)

gSig = "Tín hiệu / lọc"
i_mode = input.string("discount_premium", "Chế độ vs giá đóng", group=gSig,
     options=["off", "discount_premium", "in_va"],
     tooltip="discount_premium: long khi close ≤ POC, short khi close ≥ POC. in_va: chỉ khi close trong [VAL,VAH].")
i_requireVol = input.bool(false, "Volume ≥ SMA(20)", group=gSig)

// ─── VP core (một thanh: phân bổ volume theo overlap bin vs [low,high]) ───
f_addBarToBins(array<float> acc, float lo, float hi, float barLow, float barHigh, float vol, int nb) =>
    if vol > 0 and barHigh >= barLow and hi > lo
        span = barHigh - barLow
        step = (hi - lo) / nb
        for b = 0 to nb - 1
            bl = lo + b * step
            bh = b == nb - 1 ? hi : lo + (b + 1) * step
            oLow = math.max(barLow, bl)
            oHigh = math.min(barHigh, bh)
            if oHigh > oLow
                frac = span > 0 ? (oHigh - oLow) / span : 1.0
                array.set(acc, b, array.get(acc, b) + vol * frac)
    acc

f_expandVA(array<float> bv, int pocIdx, float vaPct) =>
    total = 0.0
    for b = 0 to array.size(bv) - 1
        total += array.get(bv, b)
    target = total * vaPct
    cum = array.get(bv, pocIdx)
    loI = pocIdx
    hiI = pocIdx
    maxIter = array.size(bv) + 2
    for iter = 0 to maxIter
        if cum >= target or total <= 0
            break
        nl = loI - 1
        nr = hiI + 1
        vl = nl >= 0 ? array.get(bv, nl) : -1.0
        vr = nr < array.size(bv) ? array.get(bv, nr) : -1.0
        if vl < 0 and vr < 0
            break
        if vr < 0 or (vl >= 0 and vl >= vr)
            cum += vl
            loI := nl
        else
            cum += vr
            hiI := nr
    [loI, hiI]

f_rollingVP(int lb, int nb, float vaPct) =>
    float poc = na
    float val = na
    float vah = na
    if bar_index + 1 >= lb and nb >= 4
        float loP = 1e100
        float hiP = 0.0
        for i = 0 to lb - 1
            loP := math.min(loP, low[i])
            hiP := math.max(hiP, high[i])
        array<float> bins = array.new_float(nb, 0.0)
        if hiP <= loP * 1.0000001
            float tv = 0.0
            for i = 0 to lb - 1
                tv += volume[i]
            if tv > 0
                float mid = (loP + hiP) / 2
                poc := mid
                val := mid
                vah := mid
        else
            for i = 0 to lb - 1
                f_addBarToBins(bins, loP, hiP, low[i], high[i], volume[i], nb)
            float best = -1.0
            int pocI = 0
            for b = 0 to nb - 1
                float w = array.get(bins, b)
                if w > best
                    best := w
                    pocI := b
            float step = (hiP - loP) / nb
            poc := loP + (pocI + 0.5) * step
            [loI, hiI] = f_expandVA(bins, pocI, vaPct)
            val := loP + loI * step
            vah := loP + (hiI + 1) * step
    [poc, val, vah]

[poc, val, vah] = f_rollingVP(i_lookback, i_bins, i_vaPct)

plot(i_showPOC ? poc : na, "POC", color=i_colPOC, linewidth=2)
pVal = plot(i_showVA ? val : na, "VAL", color=i_colVA, linewidth=1)
pVah = plot(i_showVA ? vah : na, "VAH", color=i_colVA, linewidth=1)
fill(pVal, pVah, color=i_showBg ? color.new(i_colVA, 85) : na, title="Value area")

volOk = not i_requireVol or (volume >= ta.sma(volume, 20))

inVA = not na(val) and not na(vah) and close >= val and close <= vah
discL = not na(poc) and close <= poc
premS = not na(poc) and close >= poc

longFilt = i_mode == "discount_premium" ? discL : i_mode == "in_va" ? inVA : false
shortFilt = i_mode == "discount_premium" ? premS : i_mode == "in_va" ? inVA : false

// Tín hiệu tham chiếu (kết hợp indicator khác hoặc webhook); chỉ khi mode ≠ off
longRef = i_mode != "off" and longFilt and volOk
shortRef = i_mode != "off" and shortFilt and volOk

plotshape(longRef and not longRef[1], title="Ref long (VP)", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.lime, 30), size=size.tiny, text="VP+")
plotshape(shortRef and not shortRef[1], title="Ref short (VP)", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 30), size=size.tiny, text="VP−")

enterVA = inVA and not inVA[1]
exitVA = not inVA and inVA[1]

alertcondition(ta.crossover(close, poc), "Giá cắt lên POC", "Cross up POC")
alertcondition(ta.crossunder(close, poc), "Giá cắt xuống POC", "Cross down POC")
alertcondition(enterVA, "Vào value area", "Enter value area")
alertcondition(exitVA, "Ra khỏi value area", "Exit value area")
alertcondition(longRef and not longRef[1], "VP filter: long ref", '{"tag":"vp_long_ref"}')
alertcondition(shortRef and not shortRef[1], "VP filter: short ref", '{"tag":"vp_short_ref"}')
