// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=5
strategy("VN MA Crossover (ma_crossover.py)", overlay=true, margin_long=100, margin_short=100,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.1,
     pyramiding=0, process_orders_on_close=true)

// === Khớp MACrossParams trong vn_stock/strategies/ma_crossover.py ===
fastLen   = input.int(20, "Fast MA period", minval=1)
slowLen   = input.int(50, "Slow MA period", minval=1)
useEma    = input.bool(false, "Dùng EMA (Python mặc định: SMA)")
atrLen    = input.int(14, "ATR length", minval=1)
atrSlMult = input.float(2.0, "ATR SL ×", step=0.1)
atrTpMult = input.float(3.0, "ATR TP ×", step=0.1)
volConfirm = input.bool(true, "Volume > SMA(volume, 20)")
volLen    = input.int(20, "Volume SMA length", minval=1)
showMA    = input.bool(true, "Vẽ MA")

maF = useEma ? ta.ema(close, fastLen) : ta.sma(close, fastLen)
maS = useEma ? ta.ema(close, slowLen) : ta.sma(close, slowLen)
atr = ta.atr(atrLen)
avgVol = ta.sma(volume, volLen)
volOk = not volConfirm or volume > avgVol

crossUp = maF[1] <= maS[1] and maF > maS
crossDn = maF[1] >= maS[1] and maF < maS

longCond = crossUp and close > maS and volOk

var float entrySl = na
var float entryTp = na

if longCond and strategy.position_size == 0
    float sl = close - atrSlMult * atr
    float tp = close + atrTpMult * atr
    entrySl := sl
    entryTp := tp
    strategy.entry("Long", strategy.long)
    strategy.exit("X", "Long", stop=sl, limit=tp)

if crossDn and strategy.position_size > 0
    strategy.close("Long", comment="MA cross down")
    entrySl := na
    entryTp := na

plot(showMA ? maF : na, "Fast MA", color=color.new(color.teal, 0))
plot(showMA ? maS : na, "Slow MA", color=color.new(color.orange, 0))
plotshape(longCond and strategy.position_size[1] == 0 ? low : na, title="Long", style=shape.triangleup,
     location=location.belowbar, size=size.small, color=color.new(color.green, 0))
plotshape(crossDn ? high : na, title="Exit", style=shape.triangledown,
     location=location.abovebar, size=size.small, color=color.new(color.orange, 0))
