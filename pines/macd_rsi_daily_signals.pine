//@version=5
// Chỉ báo tín hiệu — cùng điều kiện với macd_rsi_daily_strategy.pine
// overlay=false: pane riêng (histogram + mũi tên tại giá trị hist); khuyến nghị chart **1D**.
// Alert: Condition → chọn script này → ô kế bên chọn "MACD+RSI Long" / "MACD+RSI Short".
// Trigger: dùng "Once Per Bar Close", tránh "Once only".
indicator("MACD + RSI — Signals", shorttitle="MRSI Sig", overlay=false)

fastLen     = input.int(12, "MACD fast", minval=1)
slowLen     = input.int(26, "MACD slow", minval=1)
sigLen      = input.int(9, "MACD signal", minval=1)
rsiLen      = input.int(14, "RSI length", minval=2)
rsiOb       = input.float(70.0, "RSI overbought", step=0.5)
rsiOs       = input.float(30.0, "RSI oversold", step=0.5)
allowShort  = input.bool(true, "Tín hiệu short")

gTrend      = "EMA xu hướng"
useEmaTrend = input.bool(false, "Lọc EMA bull/bear", group=gTrend)
emaTrendFast = input.int(20, "EMA nhanh", minval=1, group=gTrend)
emaTrendSlow = input.int(50, "EMA chậm", minval=2, group=gTrend)

[macdLine, signalLine, histLine] = ta.macd(close, fastLen, slowLen, sigLen)
rsi = ta.rsi(close, rsiLen)
emaF = ta.ema(close, emaTrendFast)
emaS = ta.ema(close, emaTrendSlow)
bullTrend = emaF > emaS and close > emaS
bearTrend = emaF < emaS and close < emaS

longSigRaw  = ta.crossover(histLine, 0) and rsi < rsiOb
shortSigRaw = ta.crossunder(histLine, 0) and rsi > rsiOs and allowShort
longSig  = useEmaTrend ? (longSigRaw and bullTrend) : longSigRaw
shortSig = useEmaTrend ? (shortSigRaw and bearTrend) : shortSigRaw

hline(0, "Zero", color=color.gray)
plot(histLine, "MACD hist", style=plot.style_columns,
     color=histLine >= 0 ? color.new(color.teal, 40) : color.new(color.red, 40))

plotshape(longSig, title="Long", style=shape.triangleup, location=location.bottom,
     color=color.new(color.lime, 0), size=size.small, text="L")
plotshape(shortSig, title="Short", style=shape.triangledown, location=location.top,
     color=color.new(color.red, 0), size=size.small, text="S")

alertcondition(longSig, "MACD+RSI Long", '{"cmd":"long"}')
alertcondition(shortSig, "MACD+RSI Short", '{"cmd":"short"}')
